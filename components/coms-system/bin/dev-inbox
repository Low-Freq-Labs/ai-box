#!/usr/bin/env bash
set -uo pipefail

readonly DEFAULT_COMS_ROOT=/var/lib/freq-agents/coms
COMS_ROOT=$DEFAULT_COMS_ROOT
if [ "${FREQ_COMS_TESTING:-0}" = 1 ]; then
    COMS_ROOT=${FREQ_COMS_ROOT:-$COMS_ROOT}
fi

fail() {
    printf 'dev-inbox: INBOX FAILED: %s\n' "$1" >&2
    exit 1
}

if [ "$#" -ne 0 ]; then
    printf 'Usage: dev-inbox\n' >&2
    exit 1
fi

agent=$(/usr/bin/id -un) || fail 'cannot determine agent from the Linux account'
[[ "$agent" =~ ^[a-z][a-z0-9_-]*$ ]] \
    || fail "Linux account name is not a valid agent name: $agent"

inbox="$COMS_ROOT/$agent/inbox"
[ -d "$inbox" ] || fail "inbox is unavailable: $inbox"
[ -r "$inbox" ] || fail "inbox is not readable: $inbox"

shopt -s nullglob
paths=("$inbox"/*.md)
filenames=()
for path in "${paths[@]}"; do
    if [ ! -f "$path" ] || [ -L "$path" ]; then
        continue
    fi
    filename=${path##*/}
    [[ "$filename" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}_[0-9]{9}_[0-9]+_[a-z][a-z0-9_-]*\.md$ ]] \
        || continue
    filenames+=("$filename")
done

count=${#filenames[@]}
if [ "$count" -eq 0 ]; then
    printf '0 unread messages.\n'
    exit 0
fi

if [ "$count" -eq 1 ]; then
    printf '1 unread message:\n\n'
else
    printf '%s unread messages:\n\n' "$count"
fi
printf '%s\n' "${filenames[@]}" | LC_ALL=C /usr/bin/sort
