#!/usr/bin/env python3
import sys
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from freq_board import (
    BoardError,
    append_history,
    current_agent,
    find_owned_project,
    task_project_option,
    history_entry,
    locate,
    locked,
    move,
    read_text,
    require_owner,
    rewrite,
    set_blocked_reason,
    validate_reason,
)
from freq_board_transaction import transition, arguments as operation_arguments


def usage():
    print("Optional prefix: --project <project-id> (select a project explicitly)", file=sys.stderr)
    print("Usage: task-block <task-name> <reason>", file=sys.stderr)
    raise SystemExit(1)


def run(arguments):
    arguments = operation_arguments(arguments, 'task-block')
    if arguments is None:
        return
    project_id, arguments = task_project_option(arguments)
    if len(arguments) != 2:
        usage()
    task_name, reason = arguments
    validate_reason(reason)
    agent = current_agent()
    project = find_owned_project(agent, task_name, project_id)
    with locked(project):
        location = locate(project, task_name)
        require_owner(location, agent)
        content = set_blocked_reason(read_text(location["path"]), reason)
        content = append_history(
            content, history_entry(agent, "BLOCKED", reason)
        )
        location = transition(project, location, "blocked", content)
        print(f"BLOCKED: {task_name} -> blocked ({project.name})")


if __name__ == "__main__":
    try:
        run(sys.argv[1:])
    except BoardError as error:
        print(f"task-block: BLOCK FAILED: {error}", file=sys.stderr)
        raise SystemExit(1)
    except (OSError, UnicodeError, ValueError) as error:
        print(f"task-block: BLOCK FAILED: {error}", file=sys.stderr)
        raise SystemExit(1)
