[Unit]
Description=FREQ bounded host management broker
Requires=freq-host-admin.socket
After=freq-host-admin.socket

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/libexec/freq-ai-setup/host-admin/broker.py
User=root
Group=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectHome=tmpfs
BindReadOnlyPaths=-/home/freq-agents/projects
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_NET_ADMIN
AmbientCapabilities=CAP_SETUID CAP_SETGID
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
TasksMax=32
MemoryMax=192M
CPUQuota=50%
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
