[Unit]
Description=FREQ delegated APT package job
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/freq-ai-setup/host-admin/packages.py --worker
User=root
Group=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectHome=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID CAP_SETFCAP CAP_SYS_CHROOT
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID CAP_SETFCAP CAP_SYS_CHROOT
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
TasksMax=256
MemoryMax=1G
TimeoutStartSec=20min
TimeoutStopSec=90s
KillMode=control-group
Restart=no
