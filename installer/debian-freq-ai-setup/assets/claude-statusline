#!/bin/bash
set -euo pipefail

jq -r '
  def rounded: ((. // 0) | tonumber | round);
  . as $session
  | [
      (($session.model.display_name // $session.model.id // "Claude")
        + (if $session.effort.level? then " " + $session.effort.level else "" end)),
      (if $session.context_window.used_percentage? != null
       then "Context \($session.context_window.used_percentage | rounded)% used"
       else empty end),
      (if $session.rate_limits.five_hour.used_percentage? != null
       then "5hr \(100 - ($session.rate_limits.five_hour.used_percentage | rounded))% left"
       else empty end)
    ]
  | join("  ")
'
