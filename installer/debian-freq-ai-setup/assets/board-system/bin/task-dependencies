#!/usr/bin/python3 -I
"""Fixed-path, real-caller entry for advisory task dependency operations."""
import os
import sys

# Remove fixture/fault controls before importing board modules.
for name in tuple(os.environ):
    if name.startswith('FREQ_BOARD_') or name == 'FREQ_COMS_ROOT':
        del os.environ[name]
sys.dont_write_bytecode = True
sys.path.insert(0, '/usr/local/lib')
import freq_board_dependencies as dependencies

if __name__ == '__main__':
    try:
        if os.getuid() != os.geteuid() or os.getgid() != os.getegid():
            raise ValueError('Set-ID execution is unsupported')
        dependencies.run(sys.argv[1:])
    except (ValueError, OSError, KeyError, TypeError, dependencies.board.BoardError) as error:
        print('DEPENDENCY FAILED: ' + str(error)[:500], file=sys.stderr)
        sys.exit(1)
