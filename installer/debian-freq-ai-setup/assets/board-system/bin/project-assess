#!/usr/bin/env python3
import sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'lib'))
from freq_stop_gate import cli, GateError, BoardError
if __name__=='__main__':
    try:cli()
    except (GateError,BoardError,OSError,ValueError,KeyError,TypeError) as e:
        print('project-assess: ASSESSMENT FAILED: '+str(e),file=sys.stderr)
        raise SystemExit(1)
