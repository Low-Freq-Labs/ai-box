#!/usr/bin/python3
"""Add one validated public key as the configured master, never as root."""
import base64
import fcntl
import os
from pathlib import Path
import pwd
import shlex
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

SITE = Path('/etc/freq-ai-setup/site.conf')


def validate_key(value):
    value = value.strip()
    if len(value) > 16384 or any(ord(c) < 32 for c in value):
        raise ValueError('Paste one single-line PUBLIC key, not a private key.')
    fields = value.split()
    if len(fields) < 2 or not fields[0].startswith(('ssh-', 'ecdsa-', 'sk-')):
        raise ValueError('Paste a public key beginning ssh-, ecdsa-, or sk-.')
    try:
        base64.b64decode(fields[1], validate=True)
    except ValueError:
        raise ValueError('Invalid public-key encoding.') from None
    with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8') as file:
        file.write(value + '\n')
        file.flush()
        result = subprocess.run(['/usr/bin/ssh-keygen', '-l', '-E', 'sha256', '-f', file.name],
                                capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise ValueError('OpenSSH did not recognize a valid public key.')
    return value, fields[:2], ' '.join(result.stdout.split()[:2])


def duplicate(content, identity):
    for line in content.splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        try:
            fields = shlex.split(line)
        except ValueError:
            continue
        # Recognize keys with options too; never bypass their restrictions by
        # silently adding an unrestricted duplicate.
        for index in (0, 1):
            if fields[index:index + 2] == identity:
                return True
    return False


def regular(path):
    if path.is_symlink():
        raise ValueError(f'Refusing symlink: {path}')
    if path.exists():
        info = path.stat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
            raise ValueError(f'Expected a privately owned regular file: {path}')


def add_key(home, key, identity):
    ssh = home / '.ssh'
    if ssh.is_symlink() or (ssh.exists() and (not ssh.is_dir() or ssh.stat().st_uid != os.geteuid())):
        raise ValueError('Unexpected .ssh directory; nothing changed.')
    ssh.mkdir(mode=0o700, exist_ok=True)
    ssh.chmod(0o700)
    lock = ssh / '.freq-key.lock'
    regular(lock)
    descriptor = os.open(lock, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, 'r+') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        target = ssh / 'authorized_keys'
        regular(target)
        original = target.read_bytes() if target.exists() else b''
        if duplicate(original.decode('utf-8'), identity):
            target.chmod(0o600)
            return False, None
        backup = None
        if original:
            stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
            backup = ssh / f'authorized_keys.backup-{stamp}'
            fd = os.open(backup, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            with os.fdopen(fd, 'wb') as saved:
                saved.write(original)
                saved.flush()
                os.fsync(saved.fileno())
        data = original + (b'\n' if original and not original.endswith(b'\n') else b'') + key.encode() + b'\n'
        fd, temporary = tempfile.mkstemp(prefix='.authorized-keys-', dir=ssh)
        try:
            with os.fdopen(fd, 'wb') as staged:
                staged.write(data)
                staged.flush()
                os.fsync(staged.fileno())
            os.replace(temporary, target)
        finally:
            Path(temporary).unlink(missing_ok=True)
        return True, backup


def main():
    if sys.argv[1:] in (['--help'], ['-h']):
        print('Usage: update-ssh-key\nPaste one public key for the configured master. Existing keys are preserved.')
        return
    if len(sys.argv) != 1 or os.geteuid() != 0:
        raise ValueError('Run update-ssh-key from the operator account, with no arguments.')
    info = SITE.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError('Unsafe site configuration.')
    values = {}
    for line in SITE.read_text().splitlines():
        parts = shlex.split(line)
        if parts and parts[0] == 'export':
            parts = parts[1:]
        if len(parts) == 1 and '=' in parts[0]:
            name, value = parts[0].split('=', 1)
            values[name] = value
    account = pwd.getpwnam(values['FREQ_MASTER_USER'])
    home = Path(values['FREQ_MASTER_HOME'])
    if account.pw_uid == 0 or str(home) != account.pw_dir or home.resolve() != home:
        raise ValueError('Master home/account mismatch.')
    # All home inspection and writes happen without root authority.
    os.initgroups(account.pw_name, account.pw_gid)
    os.setgid(account.pw_gid)
    os.setuid(account.pw_uid)
    os.umask(0o077)
    print(f'Add SSH access for {account.pw_name}. Existing keys and password access stay unchanged.')
    value = input('Paste SSH PUBLIC key (Enter cancels): ').strip()
    if not value:
        print('Cancelled. No changes.')
        return
    key, identity, fingerprint = validate_key(value)
    print(f'Key fingerprint: {fingerprint}')
    if input(f'Authorize this key for {account.pw_name}? [y/N]: ').strip().lower() != 'y':
        print('Cancelled. No changes.')
        return
    added, backup = add_key(home, key, identity)
    print('SSH_KEY_ADDED.' if added else 'Key already authorized; no duplicate added. Existing restrictions preserved.')
    if backup:
        print(f'Previous authorized_keys saved: {backup}')
    print('Keep this session open and test SSH from a second terminal using the matching private key.')
    print('No SSH restart or password-authentication change was made.')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, KeyError, subprocess.SubprocessError) as error:
        print(f'update-ssh-key: {error}', file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        print('\nCancelled.', file=sys.stderr)
        sys.exit(130)
