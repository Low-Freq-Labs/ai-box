#!/usr/bin/env python3
"""Install verified shared developer releases; never touch AI runtime versions."""
import fcntl
import gzip
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
import zipfile
import argparse

SOURCE = Path('/usr/local/share/freq-ai-setup/devtools')
ROOT = Path('/opt/freq-agents/devtools')
BIN = Path('/usr/local/bin')


def run(*argv, **kwargs):
    return subprocess.run(argv, check=True, timeout=1800, **kwargs)


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def replace_link(path, target):
    if path.is_symlink():
        old = Path(os.readlink(path))
        if old != target and not str(old).startswith(str(ROOT) + '/'):
            raise RuntimeError(f'refusing unrelated command link: {path}')
    elif path.exists():
        raise RuntimeError(f'refusing to replace an existing command: {path}')
    temporary = path.with_name('.' + path.name + '.freq-new')
    if temporary.exists() or temporary.is_symlink():
        raise RuntimeError(f'unexpected temporary link: {temporary}')
    temporary.symlink_to(target)
    os.replace(temporary, path)


def fetch(tool, destination):
    url = tool['url']
    if not url.startswith('https://github.com/') or not re.fullmatch('[0-9a-f]{64}', tool['sha256']):
        raise RuntimeError('unsafe binary manifest entry')
    request = urllib.request.Request(url, headers={'User-Agent': 'FREQ-AI-SETUP'})
    with urllib.request.urlopen(request, timeout=90) as response, destination.open('xb') as output:
        if not response.url.startswith('https://'):
            raise RuntimeError('non-HTTPS artifact redirect')
        count = 0
        while chunk := response.read(1024 * 1024):
            count += len(chunk)
            if count > 256 * 1024 * 1024:
                raise RuntimeError('artifact exceeds size limit')
            output.write(chunk)
    if digest(destination) != tool['sha256']:
        raise RuntimeError(f'artifact checksum mismatch: {tool["name"]}')


def extract_commands(tool, archive, bindir):
    # Extract only named regular executable members; never unpack archive paths.
    for command in tool['commands']:
        if not re.fullmatch('[a-z][a-z0-9-]*', command):
            raise RuntimeError('invalid command name')
        target = bindir / command
        if target.exists():
            raise RuntimeError('duplicate binary command')
        if tool['format'] == 'binary':
            shutil.copyfile(archive, target)
        elif tool['format'] == 'gz':
            with gzip.open(archive) as stream, target.open('xb') as output:
                shutil.copyfileobj(stream, output)
        elif tool['format'] == 'tar.gz':
            with tarfile.open(archive, 'r:gz') as container:
                matches = [m for m in container.getmembers() if m.isfile() and Path(m.name).name == command]
                if len(matches) != 1:
                    raise RuntimeError(f'expected one executable member: {command}')
                with container.extractfile(matches[0]) as stream, target.open('xb') as output:
                    shutil.copyfileobj(stream, output)
        elif tool['format'] == 'zip':
            with zipfile.ZipFile(archive) as container:
                matches = [n for n in container.namelist() if Path(n).name == command and not n.endswith('/')]
                if len(matches) != 1:
                    raise RuntimeError(f'expected one executable member: {command}')
                with container.open(matches[0]) as stream, target.open('xb') as output:
                    shutil.copyfileobj(stream, output)
        else:
            raise RuntimeError('unsupported artifact format')
        target.chmod(0o755)


def install_release(generation, packages):
    bindir = generation / 'bin'
    bindir.mkdir()
    manifest = json.loads((packages / 'binaries.json').read_text())
    with tempfile.TemporaryDirectory(prefix='freq-dev-download-', dir='/var/tmp') as temporary:
        temporary = Path(temporary)
        for tool in manifest['tools']:
            print(f'Installing {tool["name"]} {tool["version"]}', flush=True)
            archive = temporary / tool['name']
            fetch(tool, archive)
            extract_commands(tool, archive, bindir)
            archive.unlink()
        env = dict(os.environ, UV_CACHE_DIR=str(temporary / 'uv-cache'),
                   UV_PYTHON_DOWNLOADS='never', UV_NO_MANAGED_PYTHON='1',
                   PIP_DISABLE_PIP_VERSION_CHECK='1')
        for name, commands in [('semgrep', ['semgrep']), ('fonttools', ['pyftsubset', 'pyftmerge', 'fonttools'])]:
            venv = generation / 'python' / name
            run('/usr/bin/python3', '-m', 'venv', '--without-pip', str(venv))
            run(str(bindir / 'uv'), 'pip', 'sync', '--python', str(venv / 'bin/python'),
                '--require-hashes', '--only-binary', ':all:', str(packages / 'python' / (name + '.txt')), env=env)
            if (venv / '.lock').exists():
                (venv / '.lock').chmod(0o600)
            for command in commands:
                (bindir / command).symlink_to(venv / 'bin' / command)
        web = generation / 'webqa'
        web.mkdir()
        for filename in ('package.json', 'package-lock.json'):
            shutil.copyfile(packages / 'webqa' / filename, web / filename)
        env = dict(os.environ, npm_config_cache=str(temporary / 'npm-cache'),
                   PLAYWRIGHT_BROWSERS_PATH=str(web / 'browsers'),
                   PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD='1')
        run('/usr/local/bin/npm', 'ci', '--engine-strict', '--ignore-scripts', '--no-fund', '--no-audit', cwd=web, env=env)
        env.pop('PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD')
        run('/usr/local/bin/node', str(web / 'node_modules/playwright/cli.js'),
            'install', 'chromium', 'firefox', 'webkit', env=env)
        q = shlex.quote
        (bindir / 'playwright').write_text(
            '#!/bin/sh\nexport PLAYWRIGHT_BROWSERS_PATH=' + q(str(web / 'browsers')) + '\n' +
            'exec /usr/local/bin/node ' + q(str(web / 'node_modules/playwright/cli.js')) + ' "$@"\n')
        (bindir / 'lighthouse').write_text(
            '#!/bin/sh\nexport PLAYWRIGHT_BROWSERS_PATH=' + q(str(web / 'browsers')) + '\n' +
            'CHROME_PATH=$(/usr/local/bin/node -e ' + q(
                'process.stdout.write(require(' + json.dumps(str(web / 'node_modules/playwright')) + ').chromium.executablePath())') + ') || exit\n' +
            'export CHROME_PATH\nexec /usr/local/bin/node ' + q(str(web / 'node_modules/lighthouse/cli/index.js')) + ' "$@"\n')
        for command in ('playwright', 'lighthouse'):
            (bindir / command).chmod(0o755)
    for command in ('uv', 'uvx', 'yq', 'delta', 'hurl', 'lychee', 'gitleaks',
                    'osv-scanner', 'duckdb', 'py-spy', 'semgrep', 'playwright', 'lighthouse'):
        run(str(bindir / command), '--version', stdout=subprocess.DEVNULL)
    run(str(bindir / 'pyftsubset'), '--help', stdout=subprocess.DEVNULL)
    receipt = {str(p.relative_to(generation)): digest(p) for p in bindir.iterdir()}
    (generation / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
    (generation / '.complete').write_text('verified command smoke tests\n')
    shutil.copytree(packages, generation / 'manifests')


def verify_release(generation):
    receipt = json.loads((generation / 'receipt.json').read_text())
    for relative, expected in receipt.items():
        if not re.fullmatch(r'bin/[a-z][a-z0-9-]*', relative):
            raise RuntimeError('invalid release receipt path')
        command = generation / relative
        if not command.is_file() or digest(command) != expected:
            raise RuntimeError(f'developer command checksum mismatch: {command.name}')


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--prepare', type=Path, help='build a root-owned candidate manifest without publishing')
    mode.add_argument('--publish', type=Path, help='publish a previously tested managed release')
    parser.add_argument('--retain-releases', action='store_true', help='retain every previous release for running clients')
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise RuntimeError('internal developer installer requires root')
    os.umask(0o022)
    packages = args.prepare or SOURCE / 'packages'
    if not args.prepare and not args.publish and (ROOT / 'current/manifests').is_dir():
        packages = ROOT / 'current/manifests'
    if packages.is_symlink() or packages.stat().st_uid or packages.stat().st_mode & 0o022:
        raise RuntimeError('unsafe package manifest directory')
    for path in [SOURCE, packages, ROOT]:
        if path.is_symlink():
            raise RuntimeError(f'unexpected symlink: {path}')
    ROOT.mkdir(parents=True, exist_ok=True)
    if ROOT.stat().st_uid != 0 or ROOT.stat().st_mode & 0o022:
        raise RuntimeError('unsafe developer tool root')
    with (ROOT / '.install.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        identity = hashlib.sha256()
        for path in sorted(packages.rglob('*')) + [Path(__file__)]:
            if path.is_file():
                identity.update(str(path.relative_to(packages) if path.is_relative_to(packages) else path.name).encode())
                identity.update(path.read_bytes())
        release_id = identity.hexdigest()[:20]
        releases = ROOT / 'releases'
        releases.mkdir(exist_ok=True)
        generation = args.publish or releases / release_id
        release_id = generation.name
        if generation.parent != releases or not re.fullmatch('[0-9a-f]{20}', generation.name) or generation.is_symlink():
            raise RuntimeError('unsafe release path')
        if args.publish and not (generation / '.complete').is_file():
            raise RuntimeError('publish requires a completed release')
        if not generation.exists():
            generation.mkdir()
            try:
                install_release(generation, packages)
            except BaseException:
                # This exact generation was created by this invocation and never published.
                shutil.rmtree(generation)
                raise
        elif not (generation / '.complete').is_file():
            raise RuntimeError(f'incomplete developer release: {generation}')
        verify_release(generation)
        if args.prepare:
            print(f'DEV_TOOLS_PREPARED {generation}')
            return
        current = ROOT / 'current'
        previous = current.resolve() if current.is_symlink() else None
        # Validate all destinations before changing the current release.
        for name, target in [('fd', Path('/usr/bin/fdfind')), ('bat', Path('/usr/bin/batcat'))]:
            path = BIN / name
            if (path.exists() or path.is_symlink()) and (not path.is_symlink() or path.readlink() != target):
                raise RuntimeError(f'command collision: {path}')
        for command in (generation / 'bin').iterdir():
            path = BIN / command.name
            if path.exists() or path.is_symlink():
                if not path.is_symlink() or not str(path.readlink()).startswith(str(ROOT) + '/'):
                    raise RuntimeError(f'command collision: {path}')
        if previous and previous != generation:
            replace_link(ROOT / 'previous', previous)
        replace_link(current, generation)
        for command in (generation / 'bin').iterdir():
            replace_link(BIN / command.name, ROOT / 'current/bin' / command.name)
        for command, target in [('fd', Path('/usr/bin/fdfind')), ('bat', Path('/usr/bin/batcat'))]:
            replace_link(BIN / command, target)
        # Keep only current plus immediately previous managed releases.
        retained = {generation}
        if (ROOT / 'previous').is_symlink():
            retained.add((ROOT / 'previous').resolve())
        for old in ([] if args.retain_releases else releases.iterdir()):
            if old in retained:
                continue
            if (old.is_symlink() or not old.is_dir() or not re.fullmatch('[0-9a-f]{20}', old.name)
                    or not (old / '.complete').is_file() or old.stat().st_uid != 0):
                raise RuntimeError(f'unexpected content in managed release directory: {old}')
            shutil.rmtree(old)
        print(f'DEV_TOOLS_READY release={release_id} root={generation}')


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError, ValueError) as error:
        print(f'devtools-install: {error}', file=sys.stderr)
        sys.exit(1)
