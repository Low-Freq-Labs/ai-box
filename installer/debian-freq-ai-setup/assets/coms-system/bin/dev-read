#!/usr/bin/env bash
set -uo pipefail

readonly DEFAULT_COMS_ROOT=/var/lib/freq-agents/coms
COMS_ROOT=$DEFAULT_COMS_ROOT
if [ "${FREQ_COMS_TESTING:-0}" = 1 ]; then
    COMS_ROOT=${FREQ_COMS_ROOT:-$COMS_ROOT}
fi

usage() {
    printf 'Usage: dev-read <exact-message-file>.md\n' >&2
}

fail() {
    printf 'dev-read: READ FAILED: %s\n' "$1" >&2
    exit 1
}

if [ "$#" -ne 1 ]; then
    usage
    exit 1
fi

filename=$1
reader=$(/usr/bin/id -un) || fail 'cannot determine reader from the Linux account'

[[ "$reader" =~ ^[a-z][a-z0-9_-]*$ ]] \
    || fail "Linux account name is not a valid agent name: $reader"
[[ "$filename" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}_[0-9]{9}_[0-9]+_[a-z][a-z0-9_-]*\.md$ ]] \
    || fail "invalid exact message filename: $filename"

agent_root="$COMS_ROOT/$reader"
inbox="$agent_root/inbox"
read_dir="$agent_root/read"
[ -d "$inbox" ] || fail "inbox is unavailable: $inbox"
[ -d "$read_dir" ] || fail "read directory is unavailable: $read_dir"
[ -w "$inbox" ] || fail "inbox is not writable: $inbox"
[ -w "$read_dir" ] || fail "read directory is not writable: $read_dir"

unread_file="$inbox/$filename"
read_file="$read_dir/$filename"

if [ -e "$unread_file" ] && [ -e "$read_file" ]; then
    fail "message exists in both inbox and read: $filename"
fi

if [ -e "$unread_file" ]; then
    if [ ! -f "$unread_file" ] || [ -L "$unread_file" ]; then
        fail "inbox message is not a regular file: $filename"
    fi
    if ! /usr/bin/mv -T -n -- "$unread_file" "$read_file"; then
        fail "could not move message from inbox to read: $filename"
    fi
    if [ -e "$unread_file" ] || [ ! -f "$read_file" ] || [ -L "$read_file" ]; then
        fail "message move did not complete cleanly: $filename"
    fi
elif [ -e "$read_file" ]; then
    if [ ! -f "$read_file" ] || [ -L "$read_file" ]; then
        fail "read message is not a regular file: $filename"
    fi
else
    fail "message not found: $filename"
fi

/usr/bin/cat -- "$read_file" || fail "could not print message: $filename"
