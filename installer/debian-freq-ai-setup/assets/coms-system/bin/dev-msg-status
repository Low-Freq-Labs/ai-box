#!/usr/bin/env python3
"""Read the caller's receipt; no body disclosure or implicit message read."""
import json
from pathlib import Path
import sys
import uuid
import os
import socket
import argparse
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'lib'))
from freq_coms_receipts import directory,read,public

try:
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('message_id');parser.add_argument('--json',action='store_true')
    args=parser.parse_args()
    ident=str(uuid.UUID(args.message_id))
    if os.environ.get('FREQ_COMS_TESTING')!='1':
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(15);sock.connect('/run/freq-host-admin.sock')
            sock.sendall(json.dumps({'area':'coms-status','message':ident}).encode());sock.shutdown(socket.SHUT_WR)
            data=bytearray()
            while chunk:=sock.recv(4096):
                data.extend(chunk)
                if len(data)>65536: raise ValueError('Oversized status response')
        reply=json.loads(data)
        if not reply['ok']: raise ValueError(reply['message'])
        print(reply['message']);raise SystemExit(0)
    value=read(directory()/(ident+'.json'))
    print(json.dumps(public(value),ensure_ascii=False,indent=2))
except (OSError,ValueError) as error:
    print('dev-msg-status: unavailable receipt ('+type(error).__name__+')',file=sys.stderr)
    sys.exit(1)
